generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleUser {
  ADMIN
  USER

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatarPath   String?  @map("avatar_url")
  name         String
  role         RoleUser @default(USER)

  createdAt DateTime @default(now()) @map("created_at")

  createdTasks   Task[]              @relation("CreatedTask")
  assignedTasks  Task[]              @relation("AssignedTask")
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  projects       Project[]           @relation("OwnedProjects")
  projectMembers ProjectMember[]
  payment        Payment[]
  plan           IsSubscriptionPlan?

  @@index(id)
  @@index(email)
  @@map("users")
}

model IsSubscriptionPlan {
  id               String           @id @default(uuid())
  userId           String           @unique
  subscriptionPlan SubscriptionPlan @default(FREE)
  isExpired        DateTime?

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("is_subscription_plans")
}

enum SubscriptionPlan {
  FREE
  PRO

  @@map("subscription_plans")
}

model RefreshToken {
  id        String  @id @default(uuid())
  token     String  @unique
  userId    String  @map("user_id")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index(userId)
  @@index(token)
  @@map("refresh_tokens")
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  ownerId String @map("owner_id")
  owner   User   @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt      DateTime        @default(now()) @map("created_at")
  projectMembers ProjectMember[]
  tasks          Task[]

  @@map("projects")
}

enum RoleMember {
  OWNER
  MEMBER
  VIEWER
}

model ProjectMember {
  id        String     @id @default(uuid())
  projectId String     @map("project_id")
  userId    String     @map("user_id")
  role      RoleMember @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Notification {
  id     String  @id @default(uuid())
  userId String  @map("user_id")
  data   String
  title  String
  isRead Boolean @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index(id)
  @@map("notifications")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  CHECKING
  DONE

  @@map("task_statuses")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH

  @@map("task_priorities")
}

enum TaskType {
  PERSONAL
  TEAM
  COMPANY

  @@map("task_types")
}

model Task {
  id          String       @id @default(uuid())
  projectId   String       @map("project_id")
  createdBy   String       @map("created_by")
  assigneeId  String?
  title       String
  description String
  start       DateTime
  end         DateTime
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  type        TaskType     @default(PERSONAL)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User     @relation("CreatedTask", fields: [createdBy], references: [id], onDelete: Cascade)
  assignee User?    @relation("AssignedTask", fields: [assigneeId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@index(id)
  @@map("tasks")
}

model Attachment {
  id       String @id @default(uuid())
  taskId   String @map("task_id")
  fileName String @map("file_name")
  fileUrl  String @map("file_url")
  fileType String @map("file_type")

  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(references: [id], fields: [taskId], onDelete: Cascade)

  @@index(id)
  @@map("attachments")
}

model Payment {
  id        String @id @default(uuid())
  userId    String
  paymentId String
  status    String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("payments")
}

model QrCodeSession {
  id        String   @id @default(uuid())
  token     String
  expired   DateTime
  status    QrStatus @default(PENDING)
  userAgent String   @unique @map("user_agent")

  @@map("qr_code_sessions")
}

enum QrStatus {
  PENDING
  SUCCESS
  REJECT

  @@map("qr_status")
}
